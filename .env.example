# Copy to .env and fill in. Never commit .env.
# Leave empty to run with the built-in fake LLM (no network, deterministic).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
# "hash" = offline keyword embedder (no download); "bge" = BAAI/bge-small-en-v1.5 via fastembed
EMBEDDER=bge
# Catalog source: "hm" downloads the H&M dataset from Hugging Face; "seed" uses data/seed_products.json
CATALOG_SOURCE=hm
CATALOG_SIZE=5000
