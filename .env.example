# Copy to .env and fill in. Never commit .env.
# Leave empty to run with the built-in fake LLM (no network, deterministic).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# "hash" = offline keyword embedder (no download); "bge" = BAAI/bge-small-en-v1.5 via fastembed
EMBEDDER=bge
# Catalog: "asos,polyvore" downloads both datasets from Hugging Face (product photos included);
# "seed" uses data/seed_products.json offline; "hm" is the older H&M dataset (no photos any more)
CATALOG_SOURCE=asos,polyvore
CATALOG_SIZE=5000
# Virtual try-on. FASHN (fast, always warm, ~$0.075 an image) is used when set; otherwise IDM-VTON on
# Replicate (~$0.02 a run, but can take minutes to boot when idle). Both empty = collage preview.
FASHN_API_KEY=
REPLICATE_API_TOKEN=
DAILY_TRYON_LIMIT=30
# Public deployments: require this code for uploads, and cap paid analyses per day.
ACCESS_CODE=
DAILY_LOOK_LIMIT=200
