# Copy to .env and fill in. Never commit .env.
# Leave empty to run with the built-in fake LLM (no network, deterministic).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5
# "hash" = offline keyword embedder (no download); "bge" = BAAI/bge-small-en-v1.5 via fastembed
EMBEDDER=bge
# Catalog: "asos,polyvore" downloads both datasets from Hugging Face (product photos included);
# "seed" uses data/seed_products.json offline; "hm" is the older H&M dataset (no photos any more)
CATALOG_SOURCE=asos,polyvore,amazon
CATALOG_SIZE=5000
# Amazon's own share on top of CATALOG_SIZE (the first import streams and embeds these once)
AMAZON_MAX_ITEMS=40000
# Virtual try-on. With a Replicate token the default is Google's Nano Banana (official model, always warm,
# one call per outfit). TRYON_MODEL=cuuupid/idm-vton is cheaper but can take minutes to boot when idle.
# FASHN_API_KEY, when set, takes precedence (specialist try-on API, ~$0.075 an image). All empty = collage.
REPLICATE_API_TOKEN=
TRYON_MODEL=google/nano-banana
# Retry a refused shop photo over HTTP/2 (a CDN may refuse the HTTP/1.1 fingerprint). Off by default.
SHOP_FETCH_HTTP2=false
FASHN_API_KEY=
DAILY_TRYON_LIMIT=30
# Public deployments: require this code for uploads, and cap paid analyses per day.
ACCESS_CODE=
DAILY_LOOK_LIMIT=200
DAILY_STYLIST_LIMIT=200
